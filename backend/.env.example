# Conexión a la base de datos
# PostgreSQL: postgresql://USUARIO:PASSWORD@localhost:5432/foodstore_db
# SQLite (desarrollo local, no requiere instalar nada): sqlite:///./foodstore.db
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/foodstore_db

# Firma del JWT: mínimo 32 caracteres
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido en CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173

# Cookie de sesión HttpOnly
COOKIE_NAME=access_token
COOKIE_SECURE=false